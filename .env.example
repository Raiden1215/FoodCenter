# Copia este archivo a ".env" (o ejecuta ./scripts/init.sh) y ajusta los valores.

# Base de datos (PostgreSQL)
POSTGRES_USER=foodcenter
POSTGRES_PASSWORD=foodcenter
POSTGRES_DB=foodcenter

# Autenticación (JWT)
JWT_SECRET=cambia-este-secreto-en-el-env
JWT_EXPIRES_IN=7d

# IA: asistente (chatbot) y pestaña "Recomendado por IA"
# Clave gratuita en https://aistudio.google.com ("Get API key"). Es un secreto: no la subas a Git ni la compartas.
# Sin clave, la app funciona igual: el asistente avisa que no está configurado y "Recomendado por IA" usa una selección de respaldo.
GEMINI_API_KEY=
# Modelo. Los nombres cambian con el tiempo (gemini-1.5-flash y gemini-2.0-flash ya se apagaron):
# confirma los vigentes en https://ai.google.dev/gemini-api/docs/models. Vacío = gemini-3.1-flash-lite
GEMINI_MODEL=
# Opcional: nivel de razonamiento (p. ej. low) para responder más rápido en los modelos que lo admiten
# GEMINI_THINKING_LEVEL=

# Correo (recuperación de contraseña)
# En desarrollo no hace falta tocar nada: los correos llegan a Mailpit (http://localhost:8025) y no salen a internet.
# Para enviar correos reales, define estas variables con los datos de tu proveedor SMTP:
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=FoodCenter <no-responder@tudominio.com>
