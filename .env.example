# Copia este archivo a ".env" (o ejecuta ./scripts/init.sh) y ajusta los valores.

# Base de datos (PostgreSQL)
POSTGRES_USER=foodcenter
POSTGRES_PASSWORD=foodcenter
POSTGRES_DB=foodcenter

# Autenticación (JWT)
JWT_SECRET=cambia-este-secreto-en-el-env
JWT_EXPIRES_IN=7d

# IA (se necesita al llegar al chatbot)
# Clave gratuita en https://aistudio.google.com
GEMINI_API_KEY=
# Modelo Flash vigente (gemini-1.5-flash ya fue retirado; confirma el nombre en la documentación)
GEMINI_MODEL=

# Correo (recuperación de contraseña)
# En desarrollo no hace falta tocar nada: los correos llegan a Mailpit (http://localhost:8025) y no salen a internet.
# Para enviar correos reales, define estas variables con los datos de tu proveedor SMTP:
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=FoodCenter <no-responder@tudominio.com>
